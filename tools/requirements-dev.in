# Dev/test-only dependencies for llgenie (pytest for the test suite).
# SINGLE source of truth for dev deps: compile to requirements-dev.txt via
# `make -C tools generate-requirements-dev` (pip-compile). Never hand-edit
# requirements-dev.txt.
#
#   make -C tools generate-requirements-dev   # compile .in -> .txt
#   make -C tools venv-dev-install            # install runtime + dev deps into venv
pytest==8.3.5
pytest-cov==5.0.0
openai==1.66.0
httpx==0.28.1   # must match tools/requirements.txt (huggingface-hub); openai>=1.66 supports it   # harness/agent OpenAI-SDK conformance (scripts/tools/llgenie_harness.py)
idna==3.19       # must match tools/requirements.txt (openai's transitive bumps it to 3.20)
tqdm==4.70.0     # must match tools/requirements.txt (openai's transitive bumps it to 4.70.1)
# Shared transitive deps must match what requirements.txt pulls (via huggingface_hub)
# so the test image's combined install (requirements.txt + requirements-dev.txt)
# does not hit a ResolutionImpossible conflict.
exceptiongroup==1.3.1
packaging==26.3
# The same advisory floors as tools/requirements.in (issue #754): the test image installs the runtime
# and dev pins together, and this compile resolves the same transitive packages, so a dev resolve
# alone could drop them below the version the scan demands.
certifi>=2026.10.18   # GHSA-6q48-6c7w-9gw2 (critical)
filelock>=4.2.1       # CVE-2026-112940 (high)
urllib3>=2.8.0        # CVE-2026-97687, CVE-2026-97689 (high)
# The security floors (issue #738): the same constraint file the runtime requirements compile
# against, so both compiled files carry the scanner's minimum versions.
-c security-floors.in
