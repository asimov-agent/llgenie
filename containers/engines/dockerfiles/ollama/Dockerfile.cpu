# GENERATED by `make generate-engine-params` from skills/engines/ollama/SKILL.md
# (pinned 02480ca2a47153e1f9c31cbe1e05536da97ce1ba). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=ollama ARCH=cpu
# Run:   make run-engine ENGINE=ollama ARCH=cpu MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM llgenie/base-cpu:646a2d1444 AS build
USER root

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        golang-go \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

FROM ubuntu:24.04
USER root
ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/llgenie/engines/ollama/0.40.15/bin /opt/llgenie/engines/ollama/0.40.15/bin
COPY --from=build /opt/llgenie/engines/ollama/0.40.15/lib /opt/llgenie/engines/ollama/0.40.15/lib
COPY --from=build /opt/llgenie/app /opt/llgenie/app
WORKDIR /opt/llgenie/app

ENV LLGENIE_ENGINE=ollama LLGENIE_BACKEND=cpu LLGENIE_VARIANT=cpu \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-ollama:cpu" llgenie.engine="ollama" \
      llgenie.variant="cpu" llgenie.pinned="02480ca2a47153e1f9c31cbe1e05536da97ce1ba" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
RUN set -eux; getent group 1000 >/dev/null || groupadd -g 1000 llgenie; getent passwd 1000 >/dev/null || useradd -u 1000 -g 1000 -m -d /var/lib/llgenie -s /usr/sbin/nologin llgenie; mkdir -p /var/lib/llgenie /models/hf && chown 1000:1000 /var/lib/llgenie /models /models/hf && chown -R 1000:1000 /opt/llgenie/app
USER 1000:1000
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
