# GENERATED by `make generate-engine-params` from skills/engines/llama.cpp-prism/SKILL.md
# (pinned 2459f68b5c0eb26261fd5a81682004b93cd645ba). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=llama.cpp-prism ARCH=vulkan
# Run:   make run-engine ENGINE=llama.cpp-prism ARCH=vulkan MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM llgenie/base-vulkan:a5119aa1b8 AS build

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}


WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 libvulkan1 mesa-vulkan-drivers libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/llgenie/src/prism-llama.cpp/build-vulkan/bin /opt/llgenie/src/prism-llama.cpp/build-vulkan/bin
COPY --from=build /opt/llgenie/app /opt/llgenie/app
WORKDIR /opt/llgenie/app

ENV LLGENIE_ENGINE=llama.cpp-prism LLGENIE_BACKEND=vulkan LLGENIE_VARIANT=vulkan \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-llama.cpp-prism:vulkan" llgenie.engine="llama.cpp-prism" \
      llgenie.variant="vulkan" llgenie.pinned="2459f68b5c0eb26261fd5a81682004b93cd645ba" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
