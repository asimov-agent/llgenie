# GENERATED by `make generate-engine-params` from skills/engines/llama.cpp-prism/SKILL.md
# (pinned e8fd209c975c80aa7fb36a8423571ff3b1b7e955). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=llama.cpp-prism ARCH=cuda
# Run:   make run-engine ENGINE=llama.cpp-prism ARCH=cuda MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM llgenie/base-cuda:79cfaf25ba AS build

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
ENV LLGENIE_CUDA_ARCH=75;80;86;89;90;120


WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

FROM nvidia/cuda:13.0.2-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/llgenie/src/prism-llama.cpp/build-cuda/bin /opt/llgenie/src/prism-llama.cpp/build-cuda/bin
COPY --from=build /opt/llgenie/app /opt/llgenie/app
WORKDIR /opt/llgenie/app

ENV LLGENIE_ENGINE=llama.cpp-prism LLGENIE_BACKEND=cuda LLGENIE_VARIANT=cuda \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-llama.cpp-prism:cuda" llgenie.engine="llama.cpp-prism" \
      llgenie.variant="cuda" llgenie.pinned="e8fd209c975c80aa7fb36a8423571ff3b1b7e955" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
