# GENERATED by `make generate-engine-params` from skills/engines/surogate/SKILL.md
# (pinned ad6c0bbf1f5c43e4ad844fcc02af5406a9323b0b). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=surogate ARCH=cuda
# Run:   make run-engine ENGINE=surogate ARCH=cuda MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM llgenie/base-cuda:79cfaf25ba

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0t64 libx11-6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

ENV LLGENIE_ENGINE=surogate LLGENIE_BACKEND=cuda LLGENIE_VARIANT=cuda \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-surogate:cuda" llgenie.engine="surogate" \
      llgenie.variant="cuda" llgenie.pinned="ad6c0bbf1f5c43e4ad844fcc02af5406a9323b0b" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
