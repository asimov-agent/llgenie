# GENERATED by `make generate-engine-params` from skills/engines/tensorfold/SKILL.md
# (pinned c425f4cc773049827ffd63c9de3ddf39f76c6749). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=tensorfold ARCH=cuda
# Run:   make run-engine ENGINE=tensorfold ARCH=cuda MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM nvcr.io/nvidia/pytorch:26.07-py3

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake ninja-build zstd python3 tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

ENV LLGENIE_ENGINE=tensorfold LLGENIE_BACKEND=cuda LLGENIE_VARIANT=cuda \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-tensorfold:cuda" llgenie.engine="tensorfold" \
      llgenie.variant="cuda" llgenie.pinned="c425f4cc773049827ffd63c9de3ddf39f76c6749" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
