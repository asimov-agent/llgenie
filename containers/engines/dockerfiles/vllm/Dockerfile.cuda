# GENERATED by `make generate-engine-params` from skills/engines/vllm/SKILL.md
# (pinned 3a4d82f569a9f57054ba81633e9b6c73b34b51fe). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=vllm ARCH=cuda
# Run:   make run-engine ENGINE=vllm ARCH=cuda MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM docker.io/vllm/vllm-openai:v0.33.0
USER root

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
ENV LLGENIE_CUDA_ARCH=75;80;86;89;90;120

# Official upstream image already contains the engine; add only what the
# llgenie entrypoint needs (python3 + curl) when the base lacks it.
RUN if ! command -v python3 >/dev/null || ! command -v curl >/dev/null; then \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates curl python3 \
      && rm -rf /var/lib/apt/lists/*; fi

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh

ENV LLGENIE_ENGINE=vllm LLGENIE_BACKEND=cuda LLGENIE_VARIANT=cuda \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-vllm:cuda" llgenie.engine="vllm" \
      llgenie.variant="cuda" llgenie.pinned="3a4d82f569a9f57054ba81633e9b6c73b34b51fe" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
RUN set -eux; getent group 1000 >/dev/null || groupadd -g 1000 llgenie; getent passwd 1000 >/dev/null || useradd -u 1000 -g 1000 -m -d /var/lib/llgenie -s /usr/sbin/nologin llgenie; mkdir -p /var/lib/llgenie /models/hf && chown 1000:1000 /var/lib/llgenie /models /models/hf && chown -R 1000:1000 /opt/llgenie/app
USER 1000:1000
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
