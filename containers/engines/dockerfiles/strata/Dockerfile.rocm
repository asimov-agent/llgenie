# GENERATED by `make generate-engine-params` from skills/engines/strata/SKILL.md
# (pinned 6f32ec070f23ced9f50e704d854d775da52591ab). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=strata ARCH=rocm
# Run:   make run-engine ENGINE=strata ARCH=rocm MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0@sha256:4449f856653602317e4101a76fce599c7fcd58ccec2e539951fce5f73083179e

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
ENV LLGENIE_GPU_TARGETS=gfx1030;gfx1100;gfx1101;gfx1102;gfx1151;gfx1200;gfx1201;gfx942

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake ninja-build zstd python3 tar libatomic1 libgomp1 python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

ENV LLGENIE_ENGINE=strata LLGENIE_BACKEND=rocm LLGENIE_VARIANT=rocm \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-strata:rocm" llgenie.engine="strata" \
      llgenie.variant="rocm" llgenie.pinned="6f32ec070f23ced9f50e704d854d775da52591ab" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
