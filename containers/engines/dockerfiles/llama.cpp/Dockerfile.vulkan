# GENERATED by `make generate-engine-params` from skills/engines/llama.cpp/SKILL.md
# (pinned 23b0202a189c44a54625aadcb37a946dd1d6278d). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=llama.cpp ARCH=vulkan
# Run:   make run-engine ENGINE=llama.cpp ARCH=vulkan MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM ghcr.io/ggml-org/llama.cpp:server-vulkan@sha256:431561ee79ee67b3980a02ff47ed9dc19496127643b75671d9789ef693ca57f9

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}

# Official upstream image already contains the engine; add only what the
# llgenie entrypoint needs (python3 + curl) when the base lacks it.
RUN if ! command -v python3 >/dev/null || ! command -v curl >/dev/null; then \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates curl python3 glslc glslang-tools libvulkan-dev spirv-headers mesa-vulkan-drivers \
      && rm -rf /var/lib/apt/lists/*; fi

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh

ENV LLGENIE_ENGINE=llama.cpp LLGENIE_BACKEND=vulkan LLGENIE_VARIANT=vulkan \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434 \
    LD_LIBRARY_PATH=/app
LABEL org.opencontainers.image.title="llgenie-llama.cpp:vulkan" llgenie.engine="llama.cpp" \
      llgenie.variant="vulkan" llgenie.pinned="23b0202a189c44a54625aadcb37a946dd1d6278d" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
