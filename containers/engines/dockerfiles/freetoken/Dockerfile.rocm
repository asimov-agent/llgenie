# GENERATED by `make generate-engine-params` from skills/engines/freetoken/SKILL.md
# (pinned 5a73685b1a836f523c692c77b70152c01698ed8e). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=freetoken ARCH=rocm
# Run:   make run-engine ENGINE=freetoken ARCH=rocm MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0@sha256:4449f856653602317e4101a76fce599c7fcd58ccec2e539951fce5f73083179e
USER root

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
ENV LLGENIE_GPU_TARGETS=gfx1100;gfx1101;gfx1102;gfx1103;gfx1200;gfx1201

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake ninja-build zstd python3 tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

ENV LLGENIE_ENGINE=freetoken LLGENIE_BACKEND=rocm LLGENIE_VARIANT=rocm \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-freetoken:rocm" llgenie.engine="freetoken" \
      llgenie.variant="rocm" llgenie.pinned="5a73685b1a836f523c692c77b70152c01698ed8e" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
RUN set -eux; getent group 1000 >/dev/null || groupadd -g 1000 llgenie; getent passwd 1000 >/dev/null || useradd -u 1000 -g 1000 -m -d /var/lib/llgenie -s /usr/sbin/nologin llgenie; mkdir -p /var/lib/llgenie /models/hf && chown 1000:1000 /var/lib/llgenie /models /models/hf && chown -R 1000:1000 /opt/llgenie/app
USER 1000:1000
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
