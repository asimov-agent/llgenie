# Build: make build-engine ENGINE=llama.cpp-laurentzuijdwijk ARCH=rocm
# Run:   make run-engine ENGINE=llama.cpp-laurentzuijdwijk ARCH=rocm MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM llgenie/base-rocm:17779d5326 AS build

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
ENV LLGENIE_GPU_TARGETS=gfx1030;gfx1100;gfx1101;gfx1102;gfx1151;gfx1200;gfx1201;gfx942


WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

FROM rocm/dev-ubuntu-24.04:7.0-complete
ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/llgenie/src/laurentzuijdwijk-llama.cpp/build-rocm/bin /opt/llgenie/src/laurentzuijdwijk-llama.cpp/build-rocm/bin
COPY --from=build /opt/llgenie/app /opt/llgenie/app
WORKDIR /opt/llgenie/app

ENV LLGENIE_ENGINE=llama.cpp-laurentzuijdwijk LLGENIE_BACKEND=rocm LLGENIE_VARIANT=rocm \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-llama.cpp-laurentzuijdwijk:rocm" llgenie.engine="llama.cpp-laurentzuijdwijk" \
      llgenie.variant="rocm" llgenie.pinned="5a09c43da038e46b1f856dc134b8128974e8574b" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
