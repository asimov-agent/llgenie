# GENERATED by `make generate-engine-params` from skills/engines/exllamav3-rocm/SKILL.md
# (pinned 5226de53a23fd5248658559b0eb876f6fc0c249a). Do not edit; edit the skill and regenerate.
# Build: make build-engine ENGINE=exllamav3-rocm ARCH=rocm
# Run:   make run-engine ENGINE=exllamav3-rocm ARCH=rocm MODEL=<model> PORT=11434
#        -> OpenAI API at http://127.0.0.1:<PORT>/v1, model llm-local
FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0@sha256:4449f856653602317e4101a76fce599c7fcd58ccec2e539951fce5f73083179e

ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/models/hf \
    PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
ENV LLGENIE_GPU_TARGETS=gfx1100,gfx1101,gfx1102,gfx1150,gfx1151,gfx1200,gfx1201

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake ninja-build zstd python3 tar hipcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llgenie/app
COPY engine_runner.py entrypoint.sh params.json ./
RUN chmod +x entrypoint.sh && python3 engine_runner.py install params.json && rm -rf /root/.cache

ENV LLGENIE_ENGINE=exllamav3-rocm LLGENIE_BACKEND=rocm LLGENIE_VARIANT=rocm \
    LLGENIE_HOST=0.0.0.0 LLGENIE_PORT=11434
LABEL org.opencontainers.image.title="llgenie-exllamav3-rocm:rocm" llgenie.engine="exllamav3-rocm" \
      llgenie.variant="rocm" llgenie.pinned="5226de53a23fd5248658559b0eb876f6fc0c249a" \
      llgenie.api="openai" llgenie.model="llm-local" llgenie.port="11434"
EXPOSE 11434
VOLUME ["/models"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=3 \
    CMD /opt/llgenie/app/entrypoint.sh health
ENTRYPOINT ["/opt/llgenie/app/entrypoint.sh"]
CMD ["serve"]
