# GENERATED by `make generate-engine-params`. Shared build toolchain for every
# compiled llgenie engine image on cuda; built once by `make build-engine-base
# BACKEND=cuda` (CI: engine-base job), cached and published, never per engine.
FROM nvidia/cuda:13.0.2-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake ninja-build zstd python3 tar \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /opt/llgenie/bin/
LABEL llgenie.base="cuda" llgenie.from="nvidia/cuda:13.0.2-devel-ubuntu24.04"
RUN set -eux; getent group 1000 >/dev/null || groupadd -g 1000 llgenie; getent passwd 1000 >/dev/null || useradd -u 1000 -g 1000 -m -d /var/lib/llgenie -s /usr/sbin/nologin llgenie; mkdir -p /var/lib/llgenie && chown 1000:1000 /var/lib/llgenie
USER 1000:1000
