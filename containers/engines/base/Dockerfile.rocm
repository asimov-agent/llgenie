# GENERATED by `make generate-engine-params`. Shared build toolchain for every
# compiled llgenie engine image on rocm; built once by `make build-engine-base
# BACKEND=rocm` (CI: engine-base job), cached and published, never per engine.
FROM rocm/dev-ubuntu-24.04:7.0-complete
ENV DEBIAN_FRONTEND=noninteractive PATH=/opt/llgenie/bin:/usr/local/cuda/bin:${PATH}
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake ninja-build zstd python3 tar \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /opt/llgenie/bin/
LABEL llgenie.base="rocm" llgenie.from="rocm/dev-ubuntu-24.04:7.0-complete"
